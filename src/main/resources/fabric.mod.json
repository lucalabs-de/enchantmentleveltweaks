{
	"schemaVersion": 1,
	"id": "better-enchantment-levels",
	"version": "${version}",
	"name": "Limitless Leveling",
	"description": "Removes level cap for most enchantments.",
	"authors": [
		"lucalabs-de"
	],
	"contact": {
		"homepage": "https://modrinth.com/project/limitless-leveling",
		"sources": "https://github.com/lucalabs-de/enchantmentleveltweaks"
	},
	"license": "GPL v3",
	"icon": "assets/better-enchantment-levels/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"de.lucalabs.enchantmentlevels.Mod"
		],
		"client": [
			"de.lucalabs.enchantmentlevels.ClientMod"
		],
		"fabric-datagen": [
			"de.lucalabs.enchantmentlevels.DataGenerator"
		]
	},
	"mixins": [
		"better-enchantment-levels.mixins.json",
		{
			"config": "better-enchantment-levels.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.5",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}